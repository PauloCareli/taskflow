# Copy to `.env` (git-ignored) in this directory. TASKAPP_JWT_SECRET is the only setting you
# have to provide; the API refuses to start without it.

# Secret used to sign access tokens: any random string of at least 32 characters. Generate and
# append one with:
#   echo "TASKAPP_JWT_SECRET=$(python3 -c 'import secrets; print(secrets.token_urlsafe(48))')" >> .env
# TASKAPP_JWT_SECRET=<your secret>

# Defaults, matching docker-compose.yml. Uncomment to change them.
# TASKAPP_DATABASE_URL=postgresql+asyncpg://taskflow:taskflow@localhost:5432/taskflow
# TASKAPP_REDIS_URL=redis://localhost:6379/0
