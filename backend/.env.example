# Copy to `.env` (git-ignored) in this directory and adjust. All variables are optional except
# TASKAPP_JWT_SECRET, without which the API refuses to start.

# Secret used to sign access tokens (at least 32 characters). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
TASKAPP_JWT_SECRET=

# Defaults match docker-compose.yml.
TASKAPP_DATABASE_URL=postgresql+asyncpg://taskflow:taskflow@localhost:5432/taskflow
TASKAPP_REDIS_URL=redis://localhost:6379/0
